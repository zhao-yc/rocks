{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rocks:browser-data:v1",
  "title": "Rocks browser data v1",
  "type": "object",
  "required": ["schemaVersion", "activeTabId", "tabs", "bookmarks", "history", "settings"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "activeTabId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tabs": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {
        "type": "object", "required": ["id", "url", "title"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "url": { "type": "string", "maxLength": 8192, "pattern": "^(https?://[^\\s]+)?$" },
          "title": { "type": "string", "maxLength": 512 }
        }
      }
    },
    "bookmarks": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/pageRecord" } },
    "history": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/pageRecord" } },
    "settings": {
      "type": "object", "required": ["searchEngine"], "additionalProperties": false,
      "properties": { "searchEngine": { "enum": ["bing", "baidu", "duckduckgo", "google"] } }
    }
  },
  "$defs": {
    "pageRecord": {
      "type": "object", "required": ["url", "title", "timestamp"], "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "maxLength": 8192, "pattern": "^https?://[^\\s]+$" },
        "title": { "type": "string", "maxLength": 512 },
        "timestamp": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
